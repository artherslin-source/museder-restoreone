Example (nonce check):\
function musere_save_email()\{\
    if ( !isset( $_POST['musere_nonce'] ) || !wp_verify_nonce( sanitize_text_field( wp_unslash( $_POST['musere_nonce'] ) ), 'musere_save_email_action' ) ) \{\
        wp_send_json_error( 'Invalid nonce.' );\
    \}\
\
    if ( !current_user_can( 'edit_posts' ) ) \{\
        wp_send_json_error( 'Insufficient permissions.' );\
    \}\
\
    if ( isset( $_POST['post_id'] ) && isset( $_POST['price'] ) ) \{\
        update_post_meta( absint( $_POST['post_id'] ), 'price', floatval( $_POST['price'] ) );\
    \}\
\}\
